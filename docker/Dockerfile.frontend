# Use Rocky Linux 9 as the base image (EL9 compatible)
FROM rockylinux:9

ARG hoot_user
ARG hoot_uid
ARG hoot_gid
ARG hoot_group
ARG hoot_shell=/bin/bash
ARG hoot_home
ARG node_version
ARG google_chrome_version

ENV HOOT_HOME=$hoot_home

# Install glibc-langpack-en for locale support and dnf-plugins-core
RUN dnf install -y glibc-langpack-en dnf-plugins-core && dnf clean all

COPY scripts/node/nodesource-repo.sh /tmp/

# Configure repositories for EL9
# NOTE: hoot-repo.sh is temporarily disabled because EL9 packages are not yet available in S3
# TODO: Re-enable once https://hoot-repo.s3.amazonaws.com/el9/deps/stable/ is populated
RUN /tmp/nodesource-repo.sh $node_version

RUN dnf config-manager --save \
        --setopt=baseos.repo_gpgcheck=1 \
        --setopt=appstream.repo_gpgcheck=1 &> /dev/null && \
    dnf makecache -y

RUN dnf -q -y install epel-release

# Install Node.js 18.x for EL9
RUN curl -sL https://rpm.nodesource.com/setup_18.x | bash -

RUN dnf -y install \
        bzip2 \
        git \
        git-core \
        nodejs-devel yarn \
        google-chrome-stable-${google_chrome_version} && \
    dnf -q -y clean all && rm -f /tmp*.sh

RUN groupadd --non-unique -g ${hoot_gid} ${hoot_group} && \
    useradd -d ${hoot_home} -m -s ${hoot_shell} -u ${hoot_uid} -g ${hoot_gid} ${hoot_user} && \
    chmod 0755 ${hoot_home}

COPY docker/scripts/frontend-entrypoint.sh /docker-entrypoint.sh
COPY docker/scripts/frontend-healthcheck.sh /docker-healthcheck.sh

USER ${hoot_user}
WORKDIR ${hoot_home}/hoot-ui-2x
ENTRYPOINT /docker-entrypoint.sh
HEALTHCHECK --interval=15s --start-period=1m CMD ["/docker-healthcheck.sh"]
