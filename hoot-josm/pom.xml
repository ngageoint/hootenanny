<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
	http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>hoot.josm</groupId>
	<artifactId>hoot-josm</artifactId>
	<packaging>jar</packaging>
	<version>0.0.1</version>
	<name>hoot-josm</name>
	<url>http://hootenanny.org</url>

	<properties>

		<jdk.version>1.8</jdk.version>

		<!--
		The hoot/JOSM integration is via JNI, which has no compile time checks and can be a fairly
		brittle interface that is difficult to debug. Upgrades may involve significant work. Think long
		and hard before you update the JOSM version here.
		-->

    <josm.artifactId>josm</josm.artifactId>
		<josm.version>19043</josm.version>

	  <!-- josm.artifactId>me-josm</josm.artifactId -->
		<!-- josm.version>10.2.2</josm.version -->

	</properties>

  <repositories>
    <repository>
      <id>josm-releases</id>
      <url>https://josm.openstreetmap.de/repository/releases/</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>josm-public</id>
      <url>https://josm.openstreetmap.de/repository/public/</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

	<dependencies>
    <dependency>
    			<groupId>org.openstreetmap.josm</groupId>
    			<artifactId>${josm.artifactId}</artifactId>
    			<version>${josm.version}</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>hoot-josm</finalName>
		<plugins>

            <!-- Fetch josm-19043.jar using Ant (works with older Maven on EL7) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>fetch-josm-jar</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/vendor"/>
                                <get src="https://josm.openstreetmap.de/download/Archiv/josm-snapshot-19043.jar"
                                     dest="${project.build.directory}/vendor/josm-19043.jar"
                                     skipexisting="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Install the downloaded JAR into the local Maven repository so the normal dependency resolves -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>install-josm-local</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${project.build.directory}/vendor/josm-19043.jar</file>
                            <groupId>org.openstreetmap.josm</groupId>
                            <artifactId>josm</artifactId>
                            <version>19043</version>
                            <packaging>jar</packaging>
                            <generatePom>true</generatePom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

			<!-- Set a compiler level -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<source>${jdk.version}</source>
					<target>${jdk.version}</target>
				</configuration>
			</plugin>

			<!-- Make this jar executable -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
				<configuration>
				  <excludes>
					<exclude>**/log4j.properties</exclude>
				  </excludes>
				  <archive>
				    <manifest>
					<addClasspath>true</addClasspath>
					<classpathPrefix>dependency-jars/</classpathPrefix>
				    </manifest>
				  </archive>
				</configuration>
			</plugin>

			<!-- Copy project dependency -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.1.1</version>
				<executions>
				  <execution>
					<id>copy-dependencies</id>
					<phase>package</phase>
					<goals>
						<goal>copy-dependencies</goal>
					</goals>
					<configuration>
					  <includeScope>runtime</includeScope>
					  <outputDirectory>${project.build.directory}/dependency-jars/</outputDirectory>
					</configuration>
				  </execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>
